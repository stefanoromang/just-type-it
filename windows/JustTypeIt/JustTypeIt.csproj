<Project Sdk="Microsoft.NET.Sdk">

  <!-- Just Type It for Windows – created by Stefano Roman Gunness · MIT License -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>JustTypeIt</AssemblyName>
    <RootNamespace>JustTypeIt</RootNamespace>
    <ApplicationIcon>AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Product>Just Type It</Product>
    <Company>Stefano Roman Gunness</Company>
    <Authors>Stefano Roman Gunness</Authors>
    <Copyright>© 2026 Stefano Roman Gunness. MIT License.</Copyright>
    <Description>Free, private AI writing assistant for Windows.</Description>
    <Version>1.1.1</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../JustTypeIt.Core/JustTypeIt.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="AppIcon.ico" LogicalName="JustTypeIt.AppIcon.ico" />
  </ItemGroup>

</Project>
